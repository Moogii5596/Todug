# Supabase төслийн Settings > API хэсгээс авна
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Нэмэлт тоглоом зохиох хэсэгт (зөвхөн сервер талд ашиглагдана)
ANTHROPIC_API_KEY=
# Заавал биш. Загваруудын жагсаалт: https://docs.claude.com
ANTHROPIC_MODEL=claude-haiku-5-5

# Нэвтрэх хуудсанд харуулах үйлчилгээ. Supabase дээр идэвхжүүлсний дараа нэмнэ: google,facebook
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Сайтын нийтийн хаяг (төгсгөлийн / тэмдэггүй). Sitemap, canonical холбоост хэрэглэнэ.
# Хоосон бол Vercel-ийн үндсэн домэйныг авна.
NEXT_PUBLIC_SITE_URL=

# Хайлтын системд сайтаа баталгаажуулах код (заавал биш). README-ийн "Хайлтын системд бүртгүүлэх" хэсгийг үзнэ үү.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Админы урилгын холбоос үүсгэхэд (зөвхөн сервер талд). Supabase > Settings > API keys > service_role / secret
SUPABASE_SERVICE_ROLE_KEY=

# Төлбөрийн хуудсанд харуулах данс эзэмшигчийн нэрийг солих бол (заавал биш)
NEXT_PUBLIC_BANK_HOLDER=
